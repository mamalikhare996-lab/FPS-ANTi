-- Helper to get Character, HumanoidRootPart, and Humanoid safely
local function GetCharParts(plr)
    if not plr or not plr.Character then return nil, nil, nil end
    local char = plr.Character
    local hrp = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
    local hum = char:FindFirstChildOfClass("Humanoid")
    return char, hrp, hum
end

-- Wipe all physics velocity on every part of LocalPlayer without anchoring (so physics never locks up!)
local function WipeCharacterVelocity(char)
    if not char or not char.Parent then return end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            part.Anchored = false
            part.Velocity = Vector3.zero
            part.RotVelocity = Vector3.zero
            pcall(function()
                part.AssemblyLinearVelocity = Vector3.zero
                part.AssemblyAngularVelocity = Vector3.zero
            end)
            if part:FindFirstAncestorOfClass("Accessory") or part:FindFirstAncestorOfClass("Tool") then
                part.CanCollide = false
            end
        end
    end
end

-- Smooth, Non-Anchoring Stabilizer so repeat flings NEVER break or cancel network packets
local function StabilizeCharacter(targetCFrame)
    DisconnectFlingConns()

    local myChar, myHRP, myHum = GetCharParts(P)
    if not myChar or not myHRP then return end

    pcall(function()
        workspace.FallenPartsDestroyHeight = S.OrigFPDH
    end)

    if myHum then
        Cam.CameraSubject = myHum
        myHum.PlatformStand = false
        myHum.Sit = false
        myHum.AutoRotate = true
        pcall(function()
            myHum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
            myHum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, true)
            myHum:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
        end)
        myHum:ChangeState(Enum.HumanoidStateType.GettingUp)
    end

    local safeCF = targetCFrame or S.SafeCFrame or myHRP.CFrame
    local _, yRot, _ = safeCF:ToEulerAnglesYXZ()
    local cleanCF = CFrame.new(safeCF.Position + Vector3.new(0, 0.4, 0)) * CFrame.Angles(0, yRot, 0)

    -- Stabilize across 8 frames without anchoring so physics engine stays awake for repeat flings
    for _ = 1, 8 do
        myChar, myHRP, myHum = GetCharParts(P)
        if not myHRP then break end
        myHRP.Anchored = false
        myHRP.CFrame = cleanCF
        WipeCharacterVelocity(myChar)
        if myHum then
            myHum:ChangeState(Enum.HumanoidStateType.GettingUp)
        end
        RS.Heartbeat:Wait()
    end

    if myHum and myHum.Parent then
        myHum:ChangeState(Enum.HumanoidStateType.Running)
    end
end

