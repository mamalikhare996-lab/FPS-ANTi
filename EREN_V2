    S.ManualStop = true
    S.LoopFling = false
    S.IsFlingAll = false
    StabilizeCharacter(S.SafeCFrame)
    S.IsFlinging = false
    if StatusLabel then
        StatusLabel.Text = "Status: Idle - Ready to Fling"
    end
end

-- Core Fling Execution: Works identically for both Single/Repeat Normal Fling and Fling All
local function ExecuteFlingOnPlayer(targetPlr, isPartOfFlingAll)
    if not targetPlr or targetPlr == P then return end

    if IsOwner(targetPlr) then
        if not isPartOfFlingAll then
            Notify("👑 Script Owner", "You cannot fling Script Owner " .. targetPlr.Name .. "!", Color3.fromRGB(255, 215, 0))
        end
        return
    end

    local myChar, myHRP, myHum = GetCharParts(P)
    local tChar, tHRP, tHum = GetCharParts(targetPlr)

    if not myHRP or not myHum then
        if not isPartOfFlingAll then
            Notify("Error", "Your character is not loaded!", Color3.fromRGB(255, 60, 60))
        end
        return
    end
    if not tHRP or (tHum and tHum.Health <= 0) then
        if not isPartOfFlingAll then
            Notify("Error", targetPlr.Name .. " is not alive or has no RootPart!", Color3.fromRGB(255, 60, 60))
        end
        return
    end

    DisconnectFlingConns()
    S.IsFlinging = true

    if not isPartOfFlingAll then
        S.ManualStop = false
        -- Save current upright standing CFrame before teleporting
        myHRP.Anchored = false
        S.SafeCFrame = myHRP.CFrame
    end

    pcall(function()
        workspace.FallenPartsDestroyHeight = 0/0
    end)

    -- Prevent our own Humanoid from ragdolling, tripping, or sitting in seats during the fling
    myHum.AutoRotate = false
    pcall(function()
        myHum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
        myHum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
        myHum:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
    end)

    StatusLabel.Text = "Status: Flinging " .. targetPlr.Name .. "..."
    if not isPartOfFlingAll then
        Notify("Fling Started", "Teleporting behind " .. targetPlr.Name .. "!", Color3.fromRGB(255, 60, 90))
    end

    local flingStartTick = tick()
    local lastValidTargetCF = tHRP.CFrame
    local movel = 0.1

    -- Real-time Sine Tween Calculator: Smoothly tweens from +BackDistance (behind target's back) to -2.6 (through target's chest) and back!
    local function ComputeBackTweenCFrame()
        local _, curTHRP = GetCharParts(targetPlr)
        if curTHRP and curTHRP.Position.Y > -300 and curTHRP.Position.Magnitude < 20000 then
            local tVel = curTHRP.Velocity
            local leadOffset = Vector3.zero
            -- Lead moving/walking targets so our back-thrust always hits dead-center
            if tVel.Magnitude > 1 and tVel.Magnitude < 160 then
                leadOffset = Vector3.new(tVel.X * 0.14, math.clamp(tVel.Y * 0.08, -3, 5), tVel.Z * 0.14)
            end
            local _, tYRot, _ = curTHRP.CFrame:ToEulerAnglesYXZ()
            lastValidTargetCF = CFrame.new(curTHRP.Position + leadOffset) * CFrame.Angles(0, tYRot, 0)
        end

        local speed = math.max(S.TweenSpeed, 0.03)
        local cycle = ((tick() - flingStartTick) / speed) % 2
        local rawAlpha = (cycle <= 1) and cycle or (2 - cycle)
        local easedAlpha = TS:GetValue(rawAlpha, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)

        -- Interpolate Z offset from +S.BackDistance (behind back) to -2.6 (inside/through target)
        local zOffset = S.BackDistance + ((-2.6 - S.BackDistance) * easedAlpha)
        return lastValidTargetCF * CFrame.new(0, 0, zOffset)
    end

    -- STAGE 1: RenderStepped (Runs BEFORE Camera & Humanoid Update)
    -- Zeroes velocity and sets upright back-tween CFrame so your character never glitches visually!
    table.insert(ActiveConns, RS.RenderStepped:Connect(function()
        if not S.IsFlinging or S.ManualStop then return end
        local _, curHRP = GetCharParts(P)
        if curHRP then
            curHRP.Anchored = false
            curHRP.Velocity = Vector3.zero
            curHRP.RotVelocity = Vector3.zero
            pcall(function()
                curHRP.AssemblyLinearVelocity = Vector3.zero
                curHRP.AssemblyAngularVelocity = Vector3.zero
            end)
            curHRP.CFrame = ComputeBackTweenCFrame()
        end
    end))

    -- STAGE 2: Stepped (Runs RIGHT BEFORE Roblox Local Physics Step)
    -- Disables local collision and applies +/-0.1 anti-sleep pulse so local physics never launches us, while keeping network replication awake!
    table.insert(ActiveConns, RS.Stepped:Connect(function()
        if not S.IsFlinging or S.ManualStop then return end
        local curChar, curHRP, curHum = GetCharParts(P)
        if not curChar or not curHRP then return end

        if curHum and curHum.Sit then
            curHum.Sit = false
        end

        for _, part in ipairs(curChar:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end

        local wakeVel = Vector3.new(0, movel, 0)
        movel = -movel

        curHRP.Anchored = false
        curHRP.Velocity = wakeVel
        curHRP.RotVelocity = Vector3.zero
        pcall(function()
            curHRP.AssemblyLinearVelocity = wakeVel
            curHRP.AssemblyAngularVelocity = Vector3.zero
        end)
        curHRP.CFrame = ComputeBackTweenCFrame()
    end))

    -- STAGE 3: Heartbeat (Runs RIGHT AFTER Local Physics & RIGHT BEFORE Server Network Replication!)
    -- Injects massive velocity + rotational spin that gets sent directly to the Server to fling the target!
    table.insert(ActiveConns, RS.Heartbeat:Connect(function()
        if not S.IsFlinging or S.ManualStop then return end
        local _, curHRP = GetCharParts(P)
        if not curHRP then return end

        local targetCF = ComputeBackTweenCFrame()
        local sign = (movel > 0) and 1 or -1

        curHRP.Anchored = false
        curHRP.CFrame = targetCF

        local lookDir = targetCF.LookVector
        local flingVec = (lookDir * 250000) + Vector3.new(0, 250000 * sign, 0)
        local rotVec = Vector3.new(250000, 250000, 250000) * sign

        curHRP.Velocity = flingVec
        curHRP.RotVelocity = rotVec
        pcall(function()
            curHRP.AssemblyLinearVelocity = flingVec
            curHRP.AssemblyAngularVelocity = rotVec
        end)
    end))

    -- Run the Back-TP + In & Out Tween for the full configured FlingDuration!
    repeat
        local phaseStart = tick()
        while (tick() - phaseStart < S.FlingDuration) and not S.ManualStop do
            myChar, myHRP, myHum = GetCharParts(P)
            tChar, tHRP, tHum = GetCharParts(targetPlr)

            if not myHRP or not tHRP or not targetPlr.Parent or (tHum and tHum.Health <= 0) then
                break
            end

            -- If target has been launched completely off the map (> 800 studs away or into the void), finish cleanly after at least 0.6s
            if (tick() - phaseStart > 0.6) and not S.LoopFling then
                if tHRP.Position.Y < -200 or (tHRP.Position - S.SafeCFrame.Position).Magnitude > 1500 then
                    break
                end
            end

            if S.ViewTarget and tHum then
                Cam.CameraSubject = tHum
            end

            RS.Heartbeat:Wait()
        end

        if S.LoopFling and not S.ManualStop and not isPartOfFlingAll then
            task.wait(0.05)
        end
    until not S.LoopFling or isPartOfFlingAll or S.ManualStop or not targetPlr.Parent

    DisconnectFlingConns()

    if not isPartOfFlingAll then
        StabilizeCharacter(S.SafeCFrame)
        S.IsFlinging = false
        StatusLabel.Text = "Status: Idle - Ready to Fling"
        if not S.ManualStop then
            Notify("Fling Complete", "Target flung & returned to safe spot!", Color3.fromRGB(45, 225, 140))
        end
    end
end

-- Wrapper for Single Player Button Click (Can be clicked repeatedly on the same player or any player!)
local function FlingTarget(targetPlr)
    if S.IsFlinging or S.IsFlingAll then
        Notify("Busy", "Already flinging! Click STOP FLING first.", Color3.fromRGB(255, 170, 50))
        return
    end
    task.spawn(function()
        local ok, err = pcall(function()
            ExecuteFlingOnPlayer(targetPlr, false)
        end)
        if not ok then
            DisconnectFlingConns()
            StabilizeCharacter(S.SafeCFrame)
            S.IsFlinging = false
            StatusLabel.Text = "Status: Idle - Ready to Fling"
            warn("Fling Error: " .. tostring(err))
        end
    end)
end

